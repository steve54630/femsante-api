<IfModule mod_rewrite.c>
    RewriteEngine On

    # Redirige tout vers index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L]
</IfModule>

# Bloque l'accès aux fichiers .env et autres sensibles
<FilesMatch "^\.env$">
    Require all denied
</FilesMatch>

<FilesMatch "(\.git|\.htaccess|\.htpasswd|composer\.json|composer\.lock|artisan)$">
    Require all denied
</FilesMatch>

# Bloque l'accès aux dossiers sensibles si quelqu'un essaie d'y accéder par erreur
<DirectoryMatch "(app|bootstrap|config|database|node_modules|resources|storage|tests|vendor)">
    Require all denied
</DirectoryMatch>

# Protège les fichiers de cache et logs
<FilesMatch "\.(log|cache|key|sqlite)$">
    Require all denied
</FilesMatch>

# Sécurise les images, JS et CSS
<FilesMatch "\.(js|css|png|jpg|jpeg|gif|svg|ico)$">
    <IfModule mod_headers.c>
        Header set X-Content-Type-Options "nosniff"
    </IfModule>
</FilesMatch>
